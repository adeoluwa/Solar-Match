# Postgres connection string (you provide this)
DATABASE_URL=postgres://user:password@localhost:5432/solar_capstone
# Set to true if your Postgres host requires SSL (Neon, Supabase, Render, Railway, ...)
DATABASE_SSL=false

# Redis — must be the same instance the worker consumes from
REDIS_URL=redis://localhost:6379

PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Base URL of the frontend, used to build the password-reset link
CLIENT_URL=http://localhost:5173

# Seeded admin account (npm run db:seed). Change these before any real deploy.
ADMIN_EMAIL=admin@solar.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULLNAME=Administrator

# Filebase (S3-compatible) storage for installer verification documents.
# Create an access key in the Filebase console and a bucket to hold the PDFs.
FILEBASE_ACCESS_TOKEN=your-filebase-access-key
FILEBASE_SECRET_KEY=your-filebase-secret-key
FILEBASE_BUCKET=solar-installer-documents
