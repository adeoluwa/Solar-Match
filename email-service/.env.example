# Postgres connection string for the email service (its own database/schema)
DATABASE_URL=postgres://user:password@localhost:5432/solar_capstone_email
DATABASE_SSL=false

PORT=5001
NODE_ENV=development

# Resend (https://resend.com) — the email provider
RESEND_API_KEY=
EMAIL_FROM="Capstone <onboarding@resend.dev>"

# Shared secret the worker must send as x-api-key (must match workers/.env)
INTERNAL_API_KEY=
