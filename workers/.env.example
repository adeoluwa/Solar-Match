# Redis connection — must point at the same instance main-app enqueues to
REDIS_URL=redis://localhost:6379

# Base URL of the email service (note the /api/v1 prefix)
EMAIL_SERVICE_URL=http://localhost:5001/api/v1

# Shared secret — must match INTERNAL_API_KEY in email-service
INTERNAL_API_KEY=

# Optional — jobs processed in parallel (default 5)
# EMAIL_CONCURRENCY=5

# Optional — max jobs/sec, to stay under Resend's rate limit (default 2)
# EMAIL_RATE_LIMIT_PER_SEC=2
